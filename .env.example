# Sao chép file này thành ".env" (bỏ phần ".example"), rồi điền giá trị thật.
# File ".env" KHÔNG được commit lên Git (đã khai báo trong .gitignore).

# ============================================================
# Tầng 5 — LLM-as-a-Judge
# ============================================================
# Chỉ cần điền 1 trong 2 key dưới đây, tùy provider bạn chọn ở TANG5_PROVIDER

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# "openai" hoặc "anthropic"
TANG5_PROVIDER=openai

# ============================================================
# Web Search — hệ thống mở rộng input-1-file (Bước 0 -> Web Search)
# ============================================================
# Google Custom Search API — lấy API key tại:
#   https://console.cloud.google.com/apis/credentials
# Hạn mức/chi phí theo tài khoản nhà cung cấp; kiểm tra trước khi chạy nhiều file.
GOOGLE_SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Search Engine ID — tạo tại:
#   https://programmablesearchengine.google.com
GOOGLE_SEARCH_ENGINE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
